# Server-side only. Generate a random value of at least 32 characters.
SESSION_SECRET=
# Permanent vault: independent versioned encryption keys (JSON). Never rotate by
# removing an old version before all records are re-encrypted and backups checked.
VAULT_ENCRYPTION_KEYS=
VAULT_ACTIVE_VERSION=v1
# Optional shared server key. For public deployments, BYOK is recommended.
GEMINI_API_KEY=

# Public Supabase project configuration for account login and practice history.
# Use a publishable key (sb_publishable_...) or legacy anon key. Never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
